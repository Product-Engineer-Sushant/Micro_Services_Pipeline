{
  "name": "@product.engineer.sushant/mssp",
  "version": "1.0.2",
  "description": "A command-line tool to automate the creation of TypeScript-based microservices in a Node.js microservice architecture. MSSP generates boilerplate files, configures environment variables and Dockerfiles, updates gateway configuration, and installs dependencies automatically.",
  "keywords": [],
  "homepage": "https://github.com/Product-Engineer-Sushant/Micro_Services_Pipeline#readme",
  "bugs": {
    "url": "https://github.com/Product-Engineer-Sushant/Micro_Services_Pipeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Product-Engineer-Sushant/Micro_Services_Pipeline.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "bin": {
    "mssp": "dist/app.js"
  },
  "scripts": {
    "dev": "ts-node-dev --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "inquirer": "^14.2.4",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
